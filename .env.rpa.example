# ============================================================================
# 벨포레 인사(HR) 무인 RPA 봇 (Playwright 실브라우저 제어) 환경변수 설정 예시
# 사용법: 이 파일을 .env.local 로 복사한 뒤 실제 계정/인증서 경로를 입력하세요.
# ============================================================================

# true 설정 시 Playwright Chromium 실브라우저를 띄워 외부 사이트 자동 로그인·업로드 수행
RPA_LIVE_BROWSER=false
RPA_HEADLESS=false

# 1. 더존 아마란스 10 그룹웨어 (전자결재 자동 기안 및 조직도/근태 동기화)
AMARANTH_URL=https://gw.belleforet.com
AMARANTH_COMPANY_CODE=BELLEFORET
AMARANTH_USER_ID=hr_admin
AMARANTH_USER_PW=

# 2. 4대사회보험 정보연계센터 & 근로복지공단 고용산재 토탈서비스 (EDI 신고)
EDI_4INSURE_URL=https://www.4insure.or.kr
COMWEL_TOTAL_URL=https://total.comwel.or.kr
CORP_CERT_PATH=C:/Users/Administrator/AppData/LocalLow/NPKI

# 3. 국세청 홈택스 & 위택스 (원천세·지방세·주민세 신고 및 3개 법인 완납증명서 무인 발급)
HOMETAX_URL=https://www.hometax.go.kr
WETAX_URL=https://www.wetax.go.kr

# 4. 하나은행 기업뱅킹 (3개 법인 급여·일용직 대량이체 파일 업로드 -> OTP 대기)
HANA_BANK_CORP_URL=https://biz.kebhana.com

# 5. 코나카드 비즈 포털 (팀장 보직수당 충전 예약)
KONA_BIZ_URL=https://biz.konacard.co.kr
